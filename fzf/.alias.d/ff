# shellcheck shell=bash
# shellcheck disable=SC2262,SC2263

if command -v fzf >/dev/null 2>&1 && command -v bat >/dev/null 2>&1; then
  alias ff='fzf --preview "bat --style=numbers --color=always {}"'
  alias eff='$EDITOR "$(ff)"'

  sff() {
    if [ "$#" -eq 0 ]; then
      echo "Usage: sff <destination> (e.g. sff host:/tmp/)"
      return 1
    fi

    local file
    file=$(find . -type f -printf '%T@\t%p\n' | sort -rn | cut -f2- | ff)
    [ -n "$file" ] || return 1
    scp "$file" "$1"
  }
fi
